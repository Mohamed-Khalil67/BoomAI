{
  "_comment": "MCP servers this pack adds to the project's .mcp.json with --mcp. A server listed in onlyWith is added only when package.json depends on that package.",
  "mcpServers": {
    "figma": { "type": "http", "url": "https://mcp.figma.com/mcp" },
    "chrome-devtools": { "command": "npx", "args": ["-y", "chrome-devtools-mcp@latest"] },
    "context7": { "type": "http", "url": "https://mcp.context7.com/mcp" },
    "angular-cli": { "command": "npx", "args": ["-y", "@angular/cli", "mcp"] }
  },
  "onlyWith": { "angular-cli": "@angular/core" }
}
